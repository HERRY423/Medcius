# ============================================================================
# Medcius 前置机环境模板（deploy/medcius.env）
# 复制为 medcius.env 后由密钥管理系统填充；**任何真实密钥不得提交进 git**。
# 变量语义见 docs/ops/PRODUCTIZATION-OPERATIONS.md §4/§3.2。
# ============================================================================

# --- 运行档位 / 治理 ---
NODE_ENV=production
MEDCIUS_PROFILE=production
# 预置并核验本地 CPU NER 权重。此路径用于合成工程回放。
MEDCIUS_CN_NER_MODEL_DIR=/opt/medcius/models/site-clinical-phi
# 真实院端由部署方切换至已审查的简体中文临床 PHI 模型目录，并同时配置下列参数。
# MEDCIUS_LIVE_HOSPITAL_DATA=1
# MEDCIUS_TENANT_ID=
# MEDCIUS_CN_CLINICAL_PHI_MANIFEST_SHA256=
# 发布治理阶梯（D6）：生产禁止直接设 advisory_mode / certified_writeback（硬性报错）
MEDCIUS_GOVERNANCE_STAGE=retrospective_study
# 正式只读来源装配模块（部署方维护的本地绝对路径，必须包含患者访问授权策略）
# 未配置时真实院端采集不可用；契约见 docs/ops/P0-INTEGRITY-AND-SILENT-CAPTURE.md。
# MEDCIUS_HOSPITAL_SOURCE_MODULE=/opt/medcius/site/source-bindings.mjs

# --- 服务监听 ---
PORT=8443
HOST=0.0.0.0
MEDCIUS_ALLOWED_ORIGINS=https://workstation.hospital.internal

# --- 密钥（全部从密钥管理系统注入；禁止默认值上生产） ---
# 密钥域隔离（P0-2）：PHI_SALT 仅用于假名化 token，不可用作静态存储加密；
# 生产缺 CLAUDE_MEDCIUS_ENCRYPTION_KEY（64hex）直接 fail-closed 拒绝启动。
MEDCIUS_JWT_SECRET=
CLAUDE_MEDCIUS_PHI_SALT=
CLAUDE_MEDCIUS_ENCRYPTION_KEY=

# --- TLS（生产强制；server.mjs 拒绝无 TLS 的生产启动） ---
MEDCIUS_TLS_KEY=/opt/medcius/tls/medcius.key
MEDCIUS_TLS_CERT=/opt/medcius/tls/medcius.crt

# --- 数据目录（审计链 append-only + 语料库） ---
CLAUDE_MEDCIUS_DATA=/opt/medcius/data

# --- 院内规则包 ---
# 医院批准后，将规则包和审批原件挂载到只读目录，并固定已批准规则包的内容摘要。
MEDCIUS_RULE_PACK_DIR=/opt/medcius/rules
# MEDCIUS_RULE_PACK_APPROVED_SHA256=

# --- LLM 推理路径（仅支持院内私有模型） ---
# topology: A=全本地（目标态） | B=混合（仅脱敏抽取文本出域，判定链留本地）
MEDCIUS_LLM_TOPOLOGY=A
MEDCIUS_LLM_ENDPOINT=http://127.0.0.1:11434/v1
MEDCIUS_LLM_MODEL_ID=Qwen2.5-7B-Instruct
MEDCIUS_LLM_MODEL_VERSION=
MEDCIUS_LLM_PROMPT_PACK_VERSION=

# --- 常驻探针（缺口六） ---
MEDCIUS_PROBE_INTERVAL_SEC=60
MEDCIUS_PROBE_LATENCY_BUDGET_MS=2000
