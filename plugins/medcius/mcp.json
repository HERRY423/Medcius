{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "国家医保编码 (NHSA Codes)": {
      "type": "streamable-http",
      "url": "https://hcls.mcp.claude.com/nhsa_codes/mcp"
    },
    "国家医保药品目录 (NHSA Drug Catalog)": {
      "type": "streamable-http",
      "url": "https://hcls.mcp.claude.com/nhsa_drug_catalog/mcp"
    },
    "NMPA 药品注册 (NMPA Drug Registry)": {
      "type": "streamable-http",
      "url": "https://hcls.mcp.claude.com/nmpa_drugs/mcp"
    },
    "中国临床试验 (China Clinical Trials)": {
      "type": "streamable-http",
      "url": "https://hcls.mcp.claude.com/china_clinical_trials/mcp"
    },
    "CMS Coverage": {
      "type": "streamable-http",
      "url": "https://hcls.mcp.claude.com/cms_coverage/mcp"
    },
    "ICD10 Codes": {
      "type": "streamable-http",
      "url": "https://hcls.mcp.claude.com/icd10_codes/mcp"
    },
    "NPI Registry": {
      "type": "streamable-http",
      "url": "https://hcls.mcp.claude.com/npi_registry/mcp"
    },
    "Clinical Trials": {
      "type": "streamable-http",
      "url": "https://hcls.mcp.claude.com/clinical_trials/mcp"
    },
    "PubMed": {
      "type": "streamable-http",
      "url": "https://pubmed.mcp.claude.com/mcp"
    },
    "Contracts Analyzer": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/servers/documents/src/index.mjs"
      ]
    },
    "FHIR": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/servers/fhir/src/index.mjs"
      ]
    }
  }
}
